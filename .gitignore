# Environnement Python : recréable avec requirements.txt, et très lourd.
venv/
.venv/
__pycache__/
*.pyc

# Base vectorielle générée : se régénère avec `python -m src.ingestion`.
chroma_db/
*.sqlite3

# Configuration locale : peut contenir des identifiants (GLPI plus tard).
.env

# Corpus documentaire : contient des procédures internes, ne doit pas être
# publié. Le dossier reste présent dans le dépôt, mais vide.
data/corpus/*
!data/corpus/.gitkeep

# Journaux d'échanges : contiennent les questions réelles des utilisateurs.
logs/
*.log

# Système et éditeurs
.DS_Store
Thumbs.db
.idea/
.vscode/

# Fichiers propres à Claude Code (instructions et lancement) : pas utiles au projet.
CLAUDE.md
.claude/

# Instance GLPI de test : ce .env ne contient que des valeurs locales jetables.
!outils/glpi-test/.env

# Jetons générés pour l'instance GLPI de test : propres à chaque poste.
outils/glpi-test/*_token.txt

outils/glpi-test/utilisateur_test.json
