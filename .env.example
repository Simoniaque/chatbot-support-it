# Modèle de configuration.
# À copier en ".env" (qui, lui, n'est jamais envoyé sur GitHub) :
#   Windows : copy .env.example .env
# Puis ajuster les valeurs si besoin.

MODELE_LLM=mistral
MODELE_EMBEDDINGS=nomic-embed-text
URL_OLLAMA=http://localhost:11434

TAILLE_CHUNK=1000
CHEVAUCHEMENT_CHUNK=150

NOMBRE_EXTRAITS=4
SEUIL_PERTINENCE=0.65

# GLPI (facultatif) : connexion des utilisateurs avec leurs identifiants GLPI,
# et création de ticket quand le chatbot ne sait pas répondre.
# Laisser vide pour désactiver. GLPI_URL sans /apirest.php.
GLPI_URL=
GLPI_APP_TOKEN=
DUREE_SESSION_HEURES=8

# Journalisation des échanges dans logs/echanges.jsonl (1 = activée, 0 = désactivée).
JOURNALISATION=1
